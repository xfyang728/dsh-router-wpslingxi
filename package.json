{
  "name": "dsh-router-wpslingxi",
  "version": "0.2.1",
  "description": "DSH plugin: WPS Lingxi (灵犀) supplier for dsh-router, over the cowork WebSocket channel. Reasoning, real sandbox code execution, model routing, and artifact fetch-back to the local working directory.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfyang728/dsh-router-wpslingxi.git"
  },
  "keywords": [
    "dsh",
    "dsh-router",
    "supplier",
    "wps",
    "lingxi"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}



